# Fartak Intelligence — environment template
# Copy to .env and fill in real values. Never commit a real .env file.

# --- Database (portable Next.js module: Prisma + PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/fartak

# --- AI provider (any OpenAI-compatible endpoint) ---
FARTAK_LLM_API_KEY=your-api-key
FARTAK_LLM_BASE_URL=https://api.openai.com/v1
FARTAK_LLM_MODEL=gpt-4o-mini

# --- Company identity & behavior ---
FARTAK_COMPANY_NAME=Puyesh Fartak Sina
FARTAK_NAV_TARGETS=home,about,services,projects,process,contact
FARTAK_CONTACT_METHODS=phone,whatsapp,telegram,email
FARTAK_REFERENCE_PREFIX=FTK