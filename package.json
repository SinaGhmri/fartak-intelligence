{
  "name": "fartak-intelligence-dev-harness",
  "private": true,
  "version": "0.0.0",
  "description": "Development-only validation harness for the portable Fartak Intelligence module (typecheck, prisma, security matrix). NOT part of the module — nothing here is copied into a host Next.js app.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate --schema fartak-intelligence/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema fartak-intelligence/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema fartak-intelligence/prisma/schema.prisma --skip-generate",
    "test": "npm run test:security && npm run test:lifecycle",
    "test:security": "tsx tests/security-matrix.ts",
    "test:lifecycle": "tsx tests/lifecycle-matrix.ts",
    "build": "cd fartak-intelligence && next build"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "framer-motion": "^12",
    "lucide-react": "^0.500.0",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6",
    "tsx": "^4",
    "typescript": "^5"
  }
}
